# Variables de configuración que usan todos los scripts

# ----- Red -----
LB_IP=192.168.10.10
WEB1_IP=192.168.10.11
WEB2_IP=192.168.10.12
RED_FRONTEND=192.168.10.0/24
RED_BACKEND=192.168.20.0/24
BBDD_IP=192.168.20.13

# ----- Base de datos -----
DB_NAME=lamp_db
DB_USER=lamp_user
DB_PASSWORD=lamp_password

# ----- Aplicación -----
APP_REPO=https://github.com/josejuansanchez/iaw-practica-lamp.git

# ----- HTTPS (Let's Encrypt) -----
DOMAIN=adrianrios.duckdns.org
LE_EMAIL=adrian5@iesalbarregas.es

# El token de DuckDNS NO se sube a GitHub: se lee del fichero duckdns_token.txt
DUCKDNS_TOKEN=$(cat /vagrant/scripts/duckdns_token.txt 2>/dev/null | tr -d '[:space:]')
